{
  "modelo": "typesafe/jev-latest",
  "calibrado": false,
  "faixa_incerta": [0.3, 0.7],
  "limite_estado_chars": 120000,
  "limite_item_chars": 4000,
  "gates": {
    "estado": {
      "tipo": "estado",
      "perguntas": [
        {
          "id": "resultado_sustentado",
          "instrucoes": "The sheet declares a result for the stage. Is the declared result sustained by the content of the handovers presented?",
          "ruim_se": "baixo"
        },
        {
          "id": "handover_descreve_como_feito_o_pendente",
          "instrucoes": "Do the handovers describe as done something that the text itself shows as not executed, pending or unverified?",
          "ruim_se": "alto"
        }
      ]
    },
    "grilling": {
      "tipo": "evidencia",
      "etapa": "01_grilling",
      "artefatos": {
        "decisoes": "docs/_sprints/{sprint}/01_grilling/handovers/decisoes.md"
      },
      "perguntas": [
        {
          "id": "decisao_fechada_sem_origem",
          "instrucoes": "Does any decision listed as closed indicate neither that the owner made it nor that it is the agent's initiative?",
          "ruim_se": "alto"
        },
        {
          "id": "pergunta_aberta_dentro_de_fechada",
          "instrucoes": "Does any decision listed as closed still contain an unanswered question or doubt?",
          "ruim_se": "alto"
        }
      ]
    },
    "dominio": {
      "tipo": "evidencia",
      "etapa": "02_domain",
      "artefatos": {
        "adrs": "docs/_sprints/{sprint}/02_domain/handovers/adrs.md"
      },
      "artefatos_citados": {
        "fonte": "adrs",
        "padrao": "/adr/(\\d{4}-[a-z0-9-]+\\.md)",
        "base": "docs/adr/"
      },
      "perguntas": [
        {
          "id": "adr_so_solucao",
          "instrucoes": "Does any ADR or consolidated decision describe only the solution, without explaining the pain that motivated it?",
          "ruim_se": "alto"
        },
        {
          "id": "termo_sem_aprovacao",
          "instrucoes": "Is any glossary term presented as approved without indicating the owner's approval?",
          "ruim_se": "alto"
        },
        {
          "id": "decisao_sem_casa",
          "instrucoes": "Does any consolidated decision fail to point to the path of the ADR, the glossary or the canon where it came to live?",
          "ruim_se": "alto"
        }
      ]
    },
    "spec": {
      "tipo": "cobertura",
      "etapa": "03_spec",
      "itens": {
        "fonte": "docs/_sprints/{sprint}/01_grilling/handovers/decisoes.md",
        "padrao": "^\\*\\*(D\\d+)\\.",
        "bloco": "ate_proximo",
        "exigir_citacao": true
      },
      "artefatos": {
        "alvo": "docs/_sprints/{sprint}/03_spec/handovers/spec.md"
      },
      "perguntas": [
        {
          "id": "coberta",
          "instrucoes": "Does the target bring a requirement, acceptance criterion or out-of-scope item that corresponds to the decision presented?",
          "ruim_se": "baixo"
        },
        {
          "id": "contradita",
          "instrucoes": "Does the target contradict the decision presented?",
          "ruim_se": "alto"
        }
      ]
    },
    "tickets": {
      "tipo": "cobertura",
      "etapa": "04_tickets",
      "itens": {
        "fonte": "docs/_sprints/{sprint}/03_spec/handovers/spec.md",
        "exigir_citacao": false
      },
      "artefatos": {
        "alvo": "docs/_sprints/{sprint}/04_tickets/handovers/tickets.md"
      },
      "perguntas": [
        {
          "id": "coberto_por_ticket",
          "instrucoes": "Does the target bring at least one ticket whose scope or acceptance criterion delivers the requirement presented?",
          "ruim_se": "baixo"
        }
      ]
    },
    "implementacao": {
      "tipo": "cobertura",
      "etapa": "05_implement",
      "itens": {
        "fonte": "docs/_sprints/{sprint}/04_tickets/handovers/tickets.md",
        "exigir_citacao": false
      },
      "artefatos": {
        "alvo": "docs/_sprints/{sprint}/05_implement/handovers/implementacao.md"
      },
      "perguntas": [
        {
          "id": "coberto_com_execucao",
          "instrucoes": "For the criterion presented, does the target record an executed command or an exercised use, with the observed result?",
          "ruim_se": "baixo"
        },
        {
          "id": "so_leitura",
          "instrucoes": "For the criterion presented, does the target offer only reading of code or of a document as proof?",
          "ruim_se": "alto"
        }
      ],
      "perguntas_globais": [
        {
          "id": "alega_sem_provar",
          "instrucoes": "Does the text declare something ready, verified or approved without showing the executed command nor the observed result?",
          "ruim_se": "alto"
        },
        {
          "id": "declara_execucao",
          "instrucoes": "Does the text record at least one test or usage command executed, with the observed result?",
          "ruim_se": "baixo"
        }
      ]
    },
    "revisao": {
      "tipo": "evidencia",
      "etapa": "06_review",
      "artefatos": {
        "revisao": "docs/_sprints/{sprint}/06_review/handovers/revisao.md",
        "pr": "docs/_sprints/{sprint}/06_review/handovers/pr.md"
      },
      "perguntas": [
        {
          "id": "achado_sem_evidencia",
          "instrucoes": "Is any review finding recorded without evidence, that is, without file, line, command or observed result?",
          "ruim_se": "alto"
        },
        {
          "id": "achado_sem_destino",
          "instrucoes": "Does any relevant finding fail to indicate whether it was fixed or became a work item?",
          "ruim_se": "alto"
        },
        {
          "id": "verificacao_alegada_sem_comando",
          "instrucoes": "Does the PR text cite verification as done without the executed command?",
          "ruim_se": "alto"
        }
      ]
    },
    "handoff": {
      "tipo": "evidencia",
      "etapa": "07_handoff",
      "artefatos": {
        "handoff": "docs/_sprints/{sprint}/07_handoff/handovers/handoff.md"
      },
      "perguntas": [
        {
          "id": "exige_memoria_da_sessao",
          "instrucoes": "Would a reader without access to the session that produced the text need context that the text does not bring in order to start the mission?",
          "ruim_se": "alto"
        },
        {
          "id": "missao_clara",
          "instrucoes": "Does the text declare a concrete mission for the next session and what must not be done?",
          "ruim_se": "baixo"
        },
        {
          "id": "alega_execucao_nao_observada",
          "instrucoes": "Does the text state as executed something that the text itself does not sustain with evidence?",
          "ruim_se": "alto"
        }
      ]
    },
    "opcoes": {
      "tipo": "opcoes",
      "empate": 0.1
    }
  },
  "conducao": {
    "gate_por_etapa": {
      "01_grilling": "grilling",
      "02_domain": "dominio",
      "03_spec": "spec",
      "04_tickets": "tickets",
      "05_implement": "implementacao",
      "06_review": "revisao",
      "07_handoff": "handoff"
    },
    "handover_por_etapa": {
      "01_grilling": "decisoes.md",
      "02_domain": "adrs.md",
      "03_spec": "spec.md",
      "04_tickets": "tickets.md",
      "05_implement": "implementacao.md",
      "06_review": "revisao.md",
      "07_handoff": "handoff.md"
    },
    "papeis_por_etapa": {
      "01_grilling": ["11-discovery-rubberduck", "53-doubt-explorer", "10-discovery-backlog"],
      "02_domain": ["20-architecture-keeper", "21-architecture-data", "54-code-explorer"],
      "03_spec": ["20-architecture-keeper", "30-ticketing-slicer", "11-discovery-rubberduck"],
      "04_tickets": ["30-ticketing-slicer", "20-architecture-keeper"],
      "05_implement": ["42-implementation-backend", "44-implementation-integration", "45-implementation-troubleshooter", "41-implementation-captain"],
      "06_review": ["60-sprint-review", "01-orchestration-reviewer", "20-architecture-keeper", "21-architecture-data"],
      "07_handoff": ["00-orchestration-icm"]
    },
    "confianca_minima_papel": 0.6,
    "guarda": {
      "proteger": [
        "docs/agents/jev-gates.json",
        "docs/_index/",
        ".omp/hooks/",
        ".omp/commands/icm.md"
      ],
      "proteger_recibos": "^docs/_sprints/[^/]+/[^/]+/handovers/jev\\.jsonl$",
      "ficha_de_etapa": "^docs/_sprints/[^/]+/\\d{2}_[a-z]+/CONTEXT\\.md$",
      "status_que_pede_dono": "status:\\s*fechado"
    },
    "graphify": {
      "ativo": true,
      "timeout_s": 120,
      "orcamento_contexto_tokens": 1500,
      "max_sementes": 5,
      "profundidade_impacto": 1,
      "max_impacto": 15
    },
    "implementacao": {
      "papel_padrao": "42-implementation-backend",
      "max_iteracoes": 3,
      "timeout_verificacao_s": 900,
      "limite_saida_chars": 6000,
      "secao_criterios": "^#{2,3}\\s+Crit[eé]rios de aceite",
      "secao_dependencias": "^#{2,3}\\s+(Depend[eê]ncias|Bloqueios|Bloqueada por)",
      "verificacao": [
        { "comando": "mix test", "requer": "mix.exs" }
      ],
      "ignorados": [
        "_build/",
        "deps/",
        ".elixir_ls/",
        "erl_crash.dump",
        "graphify-out/"
      ],
      "protegidos": [
        ".git/",
        ".omp/",
        "docs/agents/jev-gates.json",
        "docs/_index/",
        "docs/_sprints/",
        "docs/adr/",
        "docs/canon.md",
        "CONTEXT.md"
      ]
    },
    "backlog": {
      "confianca_minima_epico": 0.6,
      "perguntas": [
        {
          "id": "pergunta_delimitada",
          "instrucoes": "Does the item formulate a single delimited doubt or idea, instead of several mixed subjects?",
          "ruim_se": "baixo"
        },
        {
          "id": "afirma_sem_ancora",
          "instrucoes": "Does the item state as fact something that no arquivo:linha anchor of the item itself sustains?",
          "ruim_se": "alto"
        }
      ]
    },
    "perguntas_issue": [
      {
        "id": "tem_criterio_de_aceite",
        "instrucoes": "Does the issue body bring observable acceptance criteria, that is, something that can be verified upon finishing?",
        "ruim_se": "baixo"
      },
      {
        "id": "escopo_delimitado",
        "instrucoes": "Does the issue delimit what is in and what is out of the work?",
        "ruim_se": "baixo"
      },
      {
        "id": "declara_bloqueio",
        "instrucoes": "Does the issue depend on something that, according to the informed estado_das_etapas, has not happened yet? A dependency whose stage is already closed does not count.",
        "ruim_se": "alto"
      },
      {
        "id": "pede_codigo",
        "instrucoes": "Does the issue ask to write or change source code, and not only documentation?",
        "ruim_se": null
      }
    ]
  }
}
